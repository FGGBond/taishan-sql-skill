#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_CLI="${SCRIPT_DIR}/.venv/bin/taishan-sql"

if [[ -x "${VENV_CLI}" ]]; then
  exec "${VENV_CLI}" "$@"
fi

if command -v taishan-sql >/dev/null 2>&1; then
  exec taishan-sql "$@"
fi

for py in python3 python; do
  if command -v "${py}" >/dev/null 2>&1 && "${py}" -c "import taishan_sql" >/dev/null 2>&1; then
    exec "${py}" -m taishan_sql "$@"
  fi
done

echo "ERROR: taishan-sql is not installed." >&2
echo "From the skill root, run: bash scripts/install.sh" >&2
exit 1
